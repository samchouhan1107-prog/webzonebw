# Copy this file to .env and replace every placeholder with a real value.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false

ALLOWED_ORIGINS=https://webzonebw.in
ORDER_EMAIL=you@example.com

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

ADMIN_KEY=replace_with_a_long_random_admin_key
SESSION_SECRET=replace_with_a_long_random_session_secret
