# ============================================================
# WEBZONEBW — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env (never commit .env) and fill in real values.
# The server FAILS CLOSED when required values are missing:
#   - /api/paypal/create-order returns PAYMENT_NOT_CONFIGURED
# ============================================================

# --- PayPal (REQUIRED for the ₹499 / $5.99 license checkout) ---
# Get from https://developer.paypal.com/dashboard → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live  — MUST be "live" for real payments
PAYPAL_MODE=live
# Optional webhook secret; capture endpoint is the primary verification
PAYPAL_WEBHOOK_SECRET=

# --- Sessions / cookies ---
# Not consumed by server.js code today; reserved for future
# session handling. Provide a 64+ char random string in production
# if session middleware is added.
SESSION_SECRET=

# --- Runtime ---
NODE_ENV=production
PORT=3000
# Set to "true" when behind a reverse proxy (Render/Railway/NGINX) so
# req.protocol reflects the real client scheme (HTTPS return_url).
TRUST_PROXY=true

# --- CORS ---
# Only needed if the static frontend is hosted on a different origin
# (e.g. GitHub Pages). Comma-separated list of exact origins.
# Example: https://webzonebw.in,https://www.webzonebw.in
ALLOWED_ORIGINS=

# --- Direct email orders ---
# PayPal account email shown to buyers via the "Order via Email" button.
# Served publicly through GET /api/order-email (server-side only, never
# hardcoded in frontend). Leave empty to disable the email order channel.
ORDER_EMAIL=
