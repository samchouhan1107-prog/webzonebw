# Render.com Environment Configuration
# Copy this to .env when deploying to Render

# Runtime Configuration
NODE_ENV=production
PORT=10000
TRUST_PROXY=true
HOST=0.0.0.0

# PayPal Configuration (Get from PayPal Developer Dashboard)
PAYPAL_CLIENT_ID=your_production_client_id
PAYPAL_CLIENT_SECRET=your_production_client_secret
PAYPAL_MODE=live
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=your_production_webhook_id

# Order Processing
ORDER_EMAIL=support@webzonebw.in

# Security
ADMIN_KEY=your_admin_key_for_manual_licenses
SESSION_SECRET=your_random_session_secret

# CORS Configuration
ALLOWED_ORIGINS=https://webzonebw.in,https://www.webzonebw.in